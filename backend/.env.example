# Local values match docker-compose.yml. Locally both URLs point at the same Postgres; on Railway, DATABASE_URL is the
# Neon branch's pooled URL (runtime) and DATABASE_URL_UNPOOLED its direct URL (migrations).
# These win over the repo-root .env.local, which `neon env pull` writes only when you need to reach a Neon branch.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rehletak
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/rehletak

# Local values match docker-compose.yml. On Railway, reference each Redis service's REDIS_URL.
CACHE_URL=redis://localhost:6379
QUEUE_URL=redis://localhost:6380

# Railway injects PORT for the server service.
PORT=8080
# Browser origins allowed to call the API with cookies, comma-separated: the staff and admin dashboards.
CORS_ORIGINS=https://dashboard.local.rehletak.app:3000,https://admin.local.rehletak.app:3000

# Local https (see the README). Railway terminates TLS itself, so these are never set there.
TLS_CERT=../.certs/local.pem
TLS_KEY=../.certs/local-key.pem

# Where admin invitation links point: the admin dashboard of this environment.
ADMIN_URL=https://admin.local.rehletak.app:3000

# Email (Resend). Leave RESEND_KEY empty in development to log emails to the console instead.
RESEND_KEY=
RESEND_EMAIL=

# Seeding (db:seed). Emails an invitation link to the first admin. Only works while no admin exists.
ADMIN_EMAIL=

# Encrypts admins' two-factor secrets in the database. Changing it breaks every admin's existing authenticator setup.
TOTP_ENCRYPTION_KEY=

# Signs admin access tokens. Changing it signs every admin out.
ADMIN_SECRET=
