# Local values match docker-compose.yml. Locally both URLs point at the same Postgres; on Railway, DATABASE_URL is the
# Neon branch's pooled URL (runtime) and DATABASE_URL_UNPOOLED its direct URL (migrations).
# These win over the repo-root .env.local, which `neon env pull` writes only when you need to reach a Neon branch.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rehletak
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/rehletak

# Local values match docker-compose.yml. On Railway, reference each Redis service's REDIS_URL.
CACHE_URL=redis://localhost:6379
QUEUE_URL=redis://localhost:6380

# Railway injects PORT for the server service.
PORT=8080
# Browser origins allowed to call the API with cookies, comma-separated: the staff and admin dashboards.
CORS_ORIGINS=http://localhost:3000,http://admin.localhost:3000
