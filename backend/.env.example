# Postgres comes from Neon, not from this file: `neon checkout dev` writes DATABASE_URL (pooled, runtime)
# and DATABASE_URL_UNPOOLED (direct, migrations) into the repo-root .env.local. On Railway, set both.

# Local values match docker-compose.yml. On Railway, reference each Redis service's REDIS_URL.
CACHE_URL=redis://localhost:6379
QUEUE_URL=redis://localhost:6380

# Railway injects PORT for the server service.
PORT=8080
DASHBOARD_URL=http://localhost:3000
