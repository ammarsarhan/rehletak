model Driver {
  id String @id @default(cuid())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  firstName String
  lastName  String
  phone     String

  amountOwed Decimal @db.Decimal(12, 2)
  isExternal Boolean @default(false)
  company    String?

  trips Trip[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
}

model Vehicle {
  id String @id @default(cuid())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  make   String
  model  String
  year   Int?
  images VehicleImage[]

  plateNumber String
  color       String

  isExternal Boolean @default(false)
  office     String?

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, plateNumber])
}

model VehicleImage {
  id String @id @default(cuid())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  vehicle   Vehicle @relation(fields: [tenantId, vehicleId], references: [tenantId, id])
  vehicleId String

  // Globally unique: one bucket is shared by every tenant, keys are prefixed with the tenant's slug.
  bucket String
  key    String @unique

  createdAt DateTime @default(now())

  @@index([tenantId, vehicleId])
}
