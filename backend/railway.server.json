{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@rehletak/backend",
    "watchPatterns": ["/backend/**", "/pnpm-lock.yaml", "/pnpm-workspace.yaml", "/package.json", "/turbo.json"]
  },
  "deploy": {
    "preDeployCommand": ["pnpm --filter @rehletak/backend db:deploy"],
    "startCommand": "pnpm --filter @rehletak/backend start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
