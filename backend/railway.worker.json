{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@rehletak/backend",
    "watchPatterns": ["/backend/**", "/pnpm-lock.yaml", "/pnpm-workspace.yaml", "/package.json", "/turbo.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @rehletak/backend start:worker",
    "restartPolicyType": "ALWAYS"
  }
}
